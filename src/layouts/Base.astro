---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Nguyễn Phương Ngọc',
  description = 'Nguyễn Phương Ngọc — kỹ sư phần mềm, đang học Thạc sĩ Applied AI, quan tâm AI observability. Tác giả “Python cho AI Engineering”.',
} = Astro.props;

const path = Astro.url.pathname;
const isHome = path === '/';
const isBooks = path.startsWith('/books');
const isPoker = path.startsWith('/poker');
const isProjects = path.startsWith('/projects');
const isBlog = path.startsWith('/blog');
const SHELF = '/books/';
const BOOK = '/books/python-for-ai-engineering-volume-1/';
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Lora:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet" />
</head>
<body>
  <nav>
    <div class="wrap nav-inner">
      <a class="brand" href="/">Nguyễn Phương <b>Ngọc</b></a>
      <div class="nav-links">
        <a href="/" class={isHome ? 'active' : ''} data-i18n="nav.home">Trang chủ</a>
        <a href={SHELF} class={isBooks ? 'active' : ''} data-i18n="nav.books">Sách</a>
        <a href="/poker/" class={isPoker ? 'active' : ''} data-i18n="nav.poker">Poker</a>
        <a href="/projects/" class={isProjects ? 'active' : ''} data-i18n="nav.projects">Projects</a>
        <a href="/blog/" class={isBlog ? 'active' : ''} data-i18n="nav.blog">Viết</a>
      </div>
      <div class="nav-right">
        <div class="lang" id="lang">
          <button type="button" data-lang="vi" class="on">VI</button>
          <button type="button" data-lang="en">EN</button>
        </div>
        <a class="gh" href="#" title="GitHub" aria-label="GitHub" data-link="github">
          <svg width="19" height="19" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      </div>
    </div>
  </nav>

  <slot />

  <footer>
    <div class="wrap">
      <div class="foot">
        <div class="fl">© 2026 <b>Nguyễn Phương Ngọc</b> · satoshinguyen.com</div>
        <div class="fr">
          <a href={SHELF}>Sách</a>
          <a href="/poker/">Poker</a>
          <a href="/projects/">Projects</a>
          <a href="#" data-link="github">GitHub</a>
          <a href="#" data-link="scholar">Scholar</a>
          <a href="#" data-link="linkedin">LinkedIn</a>
        </div>
      </div>
      <p class="note">Bản dựng (v0.1). Nội dung Poker/Projects/Viết và một số liên kết (GitHub · Scholar · LinkedIn) đang chờ tác giả cấp; phần tiểu sử chờ tác giả chốt mức công bố.</p>
    </div>
  </footer>

  <script>
    // VI/EN chrome toggle (demo — full EN content is later work). Non-persistent by design.
    const I18N: Record<string, { vi: string; en: string }> = {
      'nav.home': { vi: 'Trang chủ', en: 'Home' },
      'nav.books': { vi: 'Sách', en: 'Books' },
      'nav.poker': { vi: 'Poker', en: 'Poker' },
      'nav.projects': { vi: 'Projects', en: 'Projects' },
      'nav.blog': { vi: 'Viết', en: 'Writing' },
      'hero.kicker': {
        vi: 'Kỹ sư phần mềm · đang học Thạc sĩ Applied AI',
        en: 'Software engineer · MSc Applied AI (in progress)',
      },
      'hero.role': {
        vi: 'Kỹ thuật & nghiên cứu AI · poker và lý thuyết trò chơi · xây dựng sản phẩm',
        en: 'AI engineering & research · poker and game theory · building products',
      },
    };
    function applyLang(lang: 'vi' | 'en') {
      document.documentElement.lang = lang;
      document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
        const k = el.getAttribute('data-i18n');
        if (k && I18N[k]) el.textContent = I18N[k][lang];
      });
      document.querySelectorAll<HTMLButtonElement>('#lang button').forEach((b) => {
        b.classList.toggle('on', b.dataset.lang === lang);
      });
    }
    document.querySelectorAll<HTMLButtonElement>('#lang button').forEach((b) => {
      b.addEventListener('click', () => applyLang((b.dataset.lang as 'vi' | 'en') ?? 'vi'));
    });
  </script>
</body>
</html>
