---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.date.toLocaleDateString('vi-VN', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---
<Base title={`${post.data.title} — Nguyễn Phương Ngọc`} description={post.data.title}>
  <article class="block wrap" style="border-top:none; padding-top:60px">
    <a href="/blog/" class="back">← Viết</a>
    <h1 class="post-title">{post.data.title}</h1>
    <div class="post-meta">
      <span>Nguyễn Phương Ngọc</span>
      <span class="sep">·</span>
      <time datetime={post.data.date.toISOString()}>{dateStr}</time>
      {post.data.tags.map((t) => <span class="ptag-inline">{t}</span>)}
    </div>
    <div class="prose post-body">
      <Content />
    </div>
    <p class="back-foot"><a href="/blog/" class="back">← Tất cả bài viết</a></p>
  </article>

  <style>
    .back{color:var(--dim); font-size:14px; text-decoration:none}
    .back:hover{color:var(--cyan)}
    .post-title{font-size:clamp(30px,4.5vw,46px); line-height:1.12; letter-spacing:-.02em; margin:18px 0 14px}
    .post-meta{display:flex; gap:10px; align-items:center; flex-wrap:wrap; color:var(--dimmer); font-size:14px; margin-bottom:32px}
    .post-meta .sep{opacity:.5}
    .post-meta .ptag-inline{color:var(--amber); opacity:.85}
    .post-body{max-width:68ch; margin-top:6px}
    .post-body :global(p){color:var(--dim); font-size:17px; line-height:1.78; margin:18px 0}
    .post-body :global(h2){color:var(--text); font-weight:700; letter-spacing:-.01em; font-size:clamp(22px,2.6vw,28px); line-height:1.2; margin:42px 0 12px}
    .post-body :global(em){color:var(--text); font-style:italic}
    .post-body :global(strong){color:var(--text); font-weight:600}
    .post-body :global(a){color:var(--cyan); border-bottom:1px solid color-mix(in srgb, var(--cyan) 45%, transparent)}
    .post-body :global(hr){border:none; border-top:1px solid var(--line); margin:40px 0}
    .back-foot{margin-top:48px; padding-top:22px; border-top:1px solid var(--line)}
  </style>
</Base>
