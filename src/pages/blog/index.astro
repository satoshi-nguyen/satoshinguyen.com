---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
const fmt = (d: Date) =>
  d.toLocaleDateString('vi-VN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---
<Base
  title="Viết — Nguyễn Phương Ngọc"
  description="Bài kỹ thuật và nhật ký nghề: AI engineering, observability, poker và lý thuyết trò chơi."
>
  <section class="block wrap" style="border-top:none; padding-top:72px">
    <div class="eyebrow">Viết</div>
    <h1 style="font-size:clamp(34px,5vw,52px); margin:12px 0 4px">Viết</h1>
    <p class="lead">Một nơi cho cả hai mảng — bài kỹ thuật AI và ghi chép poker — phân loại bằng thẻ.</p>

    {tags.length > 0 && (
      <div class="chip-list">
        {tags.map((t) => <span class="chip">{t}</span>)}
      </div>
    )}

    {posts.length > 0 ? (
      <div class="posts" style="margin-top:26px">
        {posts.map((p) => (
          <a class="post" href={`/blog/${p.id}/`} style="text-decoration:none">
            <span class="pdate">{fmt(p.data.date)}</span>
            <span class="ptitle">{p.data.title}</span>
            <span class="ptag">{p.data.tags.join(' · ')}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="note" style="margin-top:24px">Bài viết đang được chuẩn bị.</p>
    )}
  </section>
</Base>
