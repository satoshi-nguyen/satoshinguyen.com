---
import Base from '../../layouts/Base.astro';
const BOOK = '/books/python-for-ai-engineering-volume-1/';
const MTT = '/books/giai-ma-mtt/';
const MENTAL = '/books/mental-os-for-poker/';
---
<Base
  title="Sách — Nguyễn Phương Ngọc"
  description="Kệ sách: sách AI engineering (Nguyễn Phương Ngọc) và sách poker (Satoshi Nguyen)."
>
  <section class="block wrap" style="border-top:none; padding-top:72px">
    <div class="eyebrow">Kệ sách</div>
    <h1 style="font-size:clamp(34px,5vw,52px); margin:12px 0 4px">Sách</h1>
    <p class="lead">Sách thực hành về AI engineering, và sách poker (dưới tên Satoshi Nguyen).</p>

    <div style="display:flex; flex-direction:column; gap:18px; margin-top:30px">
      <!-- Cuốn 1 — AI -->
      <a class="bookcard" href={BOOK}>
        <div class="cover" aria-hidden="true">
          <div class="cv-top">
            <div class="cv-eyebrow">Cuốn 1 · AI</div>
            <div class="cv-title">Python cho AI Engineering</div>
            <div class="cv-sub">LLM · RAG · Agent</div>
          </div>
          <svg class="cv-bridge" viewBox="0 0 200 60" preserveAspectRatio="none"><line x1="0" y1="46" x2="200" y2="46" stroke="#9FC6E8" stroke-opacity=".5"/><line x1="70" y1="46" x2="70" y2="14" stroke="#EAF7FC" stroke-opacity=".7"/><g stroke="#5ED3F0" stroke-opacity=".7" stroke-width=".8"><line x1="70" y1="15" x2="22" y2="46"/><line x1="70" y1="15" x2="46" y2="46"/><line x1="70" y1="15" x2="104" y2="46"/><line x1="70" y1="15" x2="140" y2="46"/></g></svg>
          <div class="cv-author">Nguyễn Phương Ngọc</div>
        </div>
        <div>
          <div class="eyebrow" style="color:var(--cyan)">AI Engineering</div>
          <h2 style="font-size:23px; margin-top:6px">Python cho AI Engineering</h2>
          <p class="lead" style="margin-top:8px; font-size:16.5px">Từ lập trình cơ bản đến ứng dụng LLM, RAG và Agent. Năm dự án bối cảnh Việt Nam, mã nguồn có phiên bản.</p>
          <div class="links" style="margin-top:14px"><span style="color:var(--cyan); border-bottom:1px solid var(--cyan); padding-bottom:2px; font-weight:500; font-size:14.5px">Xem chi tiết →</span></div>
        </div>
      </a>

      <!-- Giải mã MTT — poker -->
      <a class="bookcard" href={MTT}>
        <div class="cover" aria-hidden="true" style="background:linear-gradient(160deg,#14213f,#0c1734)">
          <div class="cv-top">
            <div class="cv-eyebrow" style="color:var(--amber)">Poker</div>
            <div class="cv-title">Giải mã MTT</div>
            <div class="cv-sub">GTO for Poker Tournament</div>
          </div>
          <div style="position:absolute; left:0; right:0; bottom:26px; text-align:center; color:var(--dim); font-size:13px; letter-spacing:6px; opacity:.8">♠ ♥ ♦ ♣</div>
          <div class="cv-author">Satoshi Nguyen</div>
        </div>
        <div>
          <div class="eyebrow" style="color:var(--amber)">Poker · Satoshi Nguyen</div>
          <h2 style="font-size:23px; margin-top:6px">Giải mã MTT</h2>
          <p class="lead" style="margin-top:8px; font-size:16.5px">GTO (game theory optimal) cho giải đấu poker nhiều bàn (MTT).</p>
          <div class="status-pill" style="margin-top:12px">Đang viết · chờ xuất bản</div>
        </div>
      </a>

      <!-- Mental OS — poker -->
      <a class="bookcard" href={MENTAL}>
        <div class="cover" aria-hidden="true" style="background:linear-gradient(160deg,#14213f,#0c1734)">
          <div class="cv-top">
            <div class="cv-eyebrow" style="color:var(--amber)">Poker</div>
            <div class="cv-title" style="font-size:11.5px">Sách Thật · Body Thật · Node Thật</div>
            <div class="cv-sub">Mental OS for Poker</div>
          </div>
          <div style="position:absolute; left:0; right:0; bottom:26px; text-align:center; color:var(--dim); font-size:13px; letter-spacing:6px; opacity:.8">♠ ♥ ♦ ♣</div>
          <div class="cv-author">Satoshi Nguyen</div>
        </div>
        <div>
          <div class="eyebrow" style="color:var(--amber)">Poker · Satoshi Nguyen</div>
          <h2 style="font-size:23px; margin-top:6px">Sách Thật · Body Thật · Node Thật</h2>
          <p class="lead" style="margin-top:8px; font-size:16.5px">Mental OS for Poker — khía cạnh tâm lý &amp; mental game.</p>
          <div class="status-pill" style="margin-top:12px">Đang viết · chờ xuất bản</div>
        </div>
      </a>
    </div>
  </section>
</Base>
